=== SOURCE ===
// Представим 64-битные числа в системе счисления с основанием 10^9 (миллиард).
// Это позволяет легко складывать большие числа и печатать их без сложных алгоритмов.
fn void main() {
    // Число A = 12 000000005 (12 миллиардов 5)
    int a_high = 12;
    int a_low = 5;

    // Число B = 8 999999998 (8 миллиардов 999999998)
    int b_high = 8;
    int b_low = 999999998;

    // Сложение с переносом
    int res_low = a_low + b_low;
    int res_high = a_high + b_high;
    
    // Основание системы счисления
    int base = 1000000000;

    if (res_low >= base) {
        res_low = res_low - base;
        res_high = res_high + 1;
    }

    // Печатаем результат (21 000000003)
    print_int(res_high);
    // Дополняем нулями младшую часть, если нужно
    if (res_low < 10) {
        print_string("00000000");
    }
    print_int(res_low);
}
